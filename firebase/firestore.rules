rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function memberDepartmentId() {
      return memberDoc().data.departmentId;
    }

    function belongsToDepartment(departmentId) {
      return signedIn() && memberDepartmentId() == departmentId;
    }

    match /members/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.departmentId is string
        && request.resource.data.email is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;
      allow update, delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if belongsToDepartment(departmentId);

      match /inspections/{inspectionId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /deficiencies/{deficiencyId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /incidents/{incidentId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;

        match /commandLog/{entryId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }

        match /unitAssignments/{assignmentId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }

        match /personnelAssignments/{assignmentId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }
      }
    }
  }
}
