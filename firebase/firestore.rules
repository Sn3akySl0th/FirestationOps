rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function memberDepartmentId() {
      return memberDoc().data.departmentId;
    }

    function memberRoles() {
      return memberDoc().data.roles;
    }

    function isAdmin() {
      return signedIn() && 'ADMIN' in memberRoles();
    }

    function belongsToDepartment(departmentId) {
      return signedIn() && memberDepartmentId() == departmentId;
    }

    match /members/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.departmentId is string
        && request.resource.data.email is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;
      // Self-service profile fixes (e.g. legacy badge number stored as departmentId).
      // Role changes require an admin.
      allow update: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.id == userId
            && request.resource.data.roles == resource.data.roles
          )
          || isAdmin()
        );
      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if belongsToDepartment(departmentId);
      allow create, update: if belongsToDepartment(departmentId) && isAdmin();
      allow delete: if false;

      match /stations/{stationId} {
        allow read: if belongsToDepartment(departmentId);
        allow create, update: if belongsToDepartment(departmentId) && isAdmin();
        allow delete: if false;
      }

      match /apparatus/{apparatusId} {
        allow read: if belongsToDepartment(departmentId);
        allow create, update: if belongsToDepartment(departmentId) && isAdmin();
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow read: if belongsToDepartment(departmentId);
        allow create, update: if belongsToDepartment(departmentId) && isAdmin();
        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if belongsToDepartment(departmentId);
        allow create, update: if belongsToDepartment(departmentId)
          && (isAdmin() || request.auth.uid == memberId);
        allow delete: if false;
      }

      match /inspections/{inspectionId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /deficiencies/{deficiencyId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;
      }

      match /incidents/{incidentId} {
        allow read, create, update: if belongsToDepartment(departmentId);
        allow delete: if false;

        match /commandLog/{entryId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }

        match /unitAssignments/{assignmentId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }

        match /personnelAssignments/{assignmentId} {
          allow read, create, update: if belongsToDepartment(departmentId);
          allow delete: if false;
        }
      }
    }
  }
}
