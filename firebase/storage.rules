rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function canonicalMemberPath() {
      return /databases/(default)/documents/members/$(request.auth.uid);
    }

    function isActiveDepartmentMember(departmentId) {
      return request.auth != null
        && firestore.exists(canonicalMemberPath())
        && firestore.get(canonicalMemberPath()).data.id == request.auth.uid
        && firestore.get(canonicalMemberPath()).data.departmentId == departmentId
        && firestore.get(canonicalMemberPath()).data.isActive == true;
    }

    function isAllowedImageUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    match /departments/{departmentId}/attachments/{attachmentId} {
      allow read: if isActiveDepartmentMember(departmentId);
      allow create, update: if isActiveDepartmentMember(departmentId)
        && isAllowedImageUpload();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
